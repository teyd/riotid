{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "includeSuggestionsInTsc": true,
        "allowedUnstableApis": [
          "effect/http",
          "effect/http/HttpClient",
          "effect/http/HttpClientRequest",
          "effect/http/HttpClientResponse",
          "effect/http/FetchHttpClient",
          "@effect/platform-node/NodeHttpClient",
          "@effect/sql-sqlite-node",
          "@effect/sql-sqlite-node/SqliteClient",
          "effect/sql",
          "drizzle-orm/effect-sqlite-node"
        ],
        "diagnosticSeverity": {
          "floatingEffect": "error",
          "missingEffectContext": "error",
          "missingEffectError": "error",
          "missingLayerContext": "error",
          "unstableApiUsage": "error",
          "outdatedApi": "error",
          "globalFetchInEffect": "error",
          "globalConsoleInEffect": "error",
          "processEnvInEffect": "error",
          "runEffectInsideEffect": "error"
        },
        "overrides": [
          {
            "include": ["apps/**/src/**/*.ts", "packages/**/src/**/*.ts", "tools/**/src/**/*.ts"],
            "options": {
              "allowedUnstableApis": [
                "effect/http",
                "effect/http/HttpClient",
                "effect/http/HttpClientRequest",
                "effect/http/HttpClientResponse",
                "effect/http/FetchHttpClient",
                "@effect/platform-node/NodeHttpClient",
                "@effect/sql-sqlite-node",
                "@effect/sql-sqlite-node/SqliteClient",
                "effect/sql",
                "drizzle-orm/effect-sqlite-node"
              ],
              "diagnosticSeverity": {
                "floatingEffect": "error"
              }
            }
          }
        ]
      }
    ]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tools/**/*.ts",
    "*.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}

# @defaultSensitive=false
# Riot ID History environment contract.
#
# Infisical is installed as a Varlock plugin. Enable this block once the
# machine identity and project ID exist in Infisical, then replace the
# literal values below with infisical() resolvers.
#
# @plugin(@varlock/infisical-plugin)
# @initInfisical(projectId=$INFISICAL_PROJECT_ID, environment=dev, clientId=$INFISICAL_CLIENT_ID, clientSecret=$INFISICAL_CLIENT_SECRET)
# ---
NODE_ENV=development
PORT=8787 # @type=number
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/riotid.db
COOKIE_FILE=./data/cookies.json
RIOT_COUNTRY_CODE=US
RIOT_QR_TIMEOUT_SECONDS=300 # @type=number
AUTH_REFRESH_MINUTES=45 # @type=number
SCAN_INTERVAL_HOURS=6 # @type=number
ANON_RESOLVE_BUDGET=5000 # @type=number
ANON_SEEDS=100 # @type=number
ANON_COVERAGE_TARGET=0.9 # @type=number
MATCH_CACHE_ENABLED=true # @type=boolean
MATCH_CACHE_MATCHES_PER_REGION=1000 # @type=number
MATCH_CACHE_MAX_MATCHES_PER_REGION=10000 # @type=number
MATCH_CACHE_AUTOTUNE=true # @type=boolean
MATCH_CACHE_DAYS=30 # @type=number
INDEX_RETENTION_DAYS=30 # @type=number
BACKUP_DIRECTORY=./data/backups
BACKUP_KEEP_DAYS=7 # @type=number
RUN_RETENTION_DAYS=180 # @type=number
LOG_LEVEL=info


# Used only when the Infisical plugin block above is enabled.
INFISICAL_PROJECT_ID= # @required=false
INFISICAL_CLIENT_ID= # @sensitive @required=false
INFISICAL_CLIENT_SECRET= # @sensitive @required=false

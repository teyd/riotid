{
  "name": "riotid",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "serve": "node apps/cli/src/main.ts db:migrate && node apps/api/src/index.ts",
    "scheduler": "node apps/scheduler/src/main.ts",
    "cli": "node apps/cli/src/main.ts",
    "check": "effect-tsgo vp check && effect-tsgo tsc -p tsconfig.json",
    "lint": "effect-tsgo vp lint",
    "fmt": "vp fmt",
    "test": "vp run -r test",
    "build": "vp build apps/web",
    "smoke": "node apps/cli/src/main.ts status",
    "typecheck": "effect-tsgo tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@effect/tsgo": "0.70.0",
    "@hona/strobe": "0.44.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@varlock/infisical-plugin": "2.1.3",
    "@varlock/vite-integration": "1.5.6",
    "drizzle-kit": "1.0.0-rc.5",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "varlock": "1.25.0",
    "vite-plus": "1.7.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}
